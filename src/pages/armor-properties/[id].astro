---
// =============================================================================
// /armor-properties/<id>/ — detail page
// =============================================================================
// Glossary entry. Header (name, tags), effect panel, body content.
//
// STYLES
//   .short-effect-panel is shared via detail.css (consolidated in
//   Batch 14). Page-scoped block now only holds .glossary-body.
// =============================================================================

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import '../../styles/detail.css';

export async function getStaticPaths() {
  const properties = await getCollection('armorProperties');
  return properties.map((p) => ({
    params: { id: p.id },
    props: { entry: p },
  }));
}

interface Props {
  entry: CollectionEntry<'armorProperties'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const pageTitle = entry.data.name;
const pageDescription = entry.data.short_effect;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageClass="armor-property-detail-page"
>
  <div class="container">
    <article class="detail-article prose-wide">

      <nav class="detail-back" aria-label="Back navigation">
        <a href="/armor-properties/" class="detail-back__link">
          ← All Armor Properties
        </a>
      </nav>

      <header class="detail-header">
        <h1 class="detail-header__title">{entry.data.name}</h1>

        {entry.data.tags.length > 0 && (
          <div class="detail-header__badges">
            {entry.data.tags.map((t) => (
              <Badge variant="muted" label={t} size="sm" />
            ))}
          </div>
        )}
      </header>

      <p class="short-effect-panel">
        <strong>Effect:</strong> {entry.data.short_effect}
      </p>

      <section class="glossary-body">
        <Content />
      </section>

    </article>
  </div>
</BaseLayout>

<style>
  .glossary-body {
    margin-top: var(--space-4);
  }

  .glossary-body p:last-child {
    margin-bottom: 0;
  }
</style>
