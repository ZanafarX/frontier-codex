---
// =============================================================================
// /settlements/<id>/ — detail page
// =============================================================================
// One page per settlement. 6 pages total.
//
// LAYOUT
//   1. Back-link to PARENT REGION (contextual; e.g. "← The Ash Belt")
//   2. Header: name (h1), sub_name (italic), atmosphere (blockquote)
//   3. <StatBlock>: Region · Faction Control · Population
//   4. <Content />: body (atmosphere, laws, availability quirks)
//   5. Districts section: cards of {name, description}
//   6. Plot Hooks section: cards of {name, description}
//   7. Environmental Mechanics: simple badge list (when any)
//   8. Key NPCs section: linked badges (NPC detail pages 404 for now)
//   9. Cross-refs footer: parent region badge
// =============================================================================

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import StatBlock, { type StatRow } from '../../components/StatBlock.astro';
import { formatRegion } from '../../lib/formatters';
import '../../styles/detail.css';

// --- Static path generation -------------------------------------------------

export async function getStaticPaths() {
  const settlements = await getCollection('settlements');
  const npcs = await getCollection('npcs');

  // NPC ID → display-name lookup. Built once, reused across all 6 pages.
  const npcNameById = new Map<string, string>(
    npcs.map((n) => [n.id, n.data.name]),
  );

  return settlements.map((s) => {
    const resolvedNpcs = s.data.key_npcs.map((id) => ({
      id,
      name: npcNameById.get(id),  // undefined when unresolved
    }));

    return {
      params: { id: s.id },
      props: { entry: s, resolvedNpcs },
    };
  });
}

// --- Page rendering ---------------------------------------------------------

interface Props {
  entry: CollectionEntry<'settlements'>;
  resolvedNpcs: Array<{ id: string; name: string | undefined }>;
}

const { entry, resolvedNpcs } = Astro.props;
const { Content } = await render(entry);

const regionLabel = formatRegion(entry.data.region);

const statRows: StatRow[] = [
  { label: 'Region', value: regionLabel, mono: false },
  { label: 'Faction Control', value: entry.data.faction_control, mono: false },
];
if (typeof entry.data.population === 'number') {
  statRows.push({
    label: 'Population',
    value: entry.data.population.toLocaleString(),
  });
}

const hasDistricts = entry.data.districts.length > 0;
const hasPlotHooks = entry.data.plot_hooks.length > 0;
const hasEnvMechanics = entry.data.environmental_mechanics.length > 0;
const hasNpcs = resolvedNpcs.length > 0;

const pageTitle = entry.data.name;
const subtitle = entry.data.sub_name ?? '';
const pageDescription = `${entry.data.atmosphere} — a settlement in ${regionLabel}.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageClass="settlement-detail-page"
>
  <div class="container">
    <article class="detail-article prose-wide">

      <nav class="detail-back" aria-label="Back navigation">
        <a href={`/regions/${entry.data.region}/`} class="detail-back__link">
          ← {regionLabel}
        </a>
      </nav>

      <header class="detail-header">
        <h1 class="detail-header__title">{entry.data.name}</h1>

        {subtitle && (
          <p class="detail-header__subname">{subtitle}</p>
        )}

        <blockquote class="detail-header__atmosphere">
          <em>{entry.data.atmosphere}</em>
        </blockquote>
      </header>

      <StatBlock rows={statRows} />

      <section class="settlement-body">
        <Content />
      </section>

      {hasDistricts && (
        <section class="settlement-section">
          <h2 class="settlement-section__title">Districts</h2>
          <div class="named-entries">
            {entry.data.districts.map((d) => (
              <article class="named-entry">
                <h3 class="named-entry__title">{d.name}</h3>
                <p class="named-entry__desc">{d.description}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {hasPlotHooks && (
        <section class="settlement-section">
          <h2 class="settlement-section__title">Plot Hooks</h2>
          <p class="settlement-section__lede">
            Threads waiting to be pulled. GM-facing prompts.
          </p>
          <div class="named-entries">
            {entry.data.plot_hooks.map((p) => (
              <article class="named-entry named-entry--hook">
                <h3 class="named-entry__title">{p.name}</h3>
                <p class="named-entry__desc">{p.description}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {hasEnvMechanics && (
        <section class="settlement-section">
          <h2 class="settlement-section__title">Environmental Mechanics</h2>
          <ul class="env-mechanics">
            {entry.data.environmental_mechanics.map((m) => <li>{m}</li>)}
          </ul>
        </section>
      )}

      {hasNpcs && (
        <section class="settlement-section">
          <h2 class="settlement-section__title">Key Figures</h2>
          <div class="key-npcs">
            {resolvedNpcs.map((n) =>
              n.name ? (
                <Badge
                  variant="default"
                  label={n.name}
                  href={`/npcs/${n.id}/`}
                />
              ) : (
                <Badge variant="muted" label={n.id} />
              ),
            )}
          </div>
        </section>
      )}

      <footer class="detail-refs">
        <div class="detail-refs__group">
          <h2 class="detail-refs__label">Region</h2>
          <div class="detail-refs__items">
            <Badge
              variant="region"
              label={regionLabel}
              href={`/regions/${entry.data.region}/`}
              size="sm"
            />
          </div>
        </div>
      </footer>

    </article>
  </div>
</BaseLayout>

<style>
  .detail-header__subname {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin: var(--space-2) 0 0;
    line-height: var(--line-snug);
  }

  .detail-header__atmosphere {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-highlight);
    font-size: var(--text-lg);
    margin: var(--space-4) 0 0;
    padding: 0;
    border: none;
    background: none;
    line-height: var(--line-snug);
  }

  .settlement-body {
    margin-top: var(--space-4);
  }

  .settlement-section {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
  }

  .settlement-section__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-accent);
    margin: 0 0 var(--space-2);
  }

  .settlement-section__lede {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    margin: 0 0 var(--space-4);
    line-height: var(--line-snug);
  }

  /* --- Named entry cards (Districts, Plot Hooks) ----------------------- */

  .named-entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .named-entry {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }

  .named-entry--hook {
    border-left: 3px solid var(--color-accent);
  }

  .named-entry__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-accent);
    margin: 0 0 var(--space-2);
    line-height: var(--line-tight);
    font-style: normal;
  }

  .named-entry__desc {
    font-family: var(--font-serif);
    color: var(--color-text);
    font-size: var(--text-base);
    line-height: var(--line-base);
    margin: 0;
  }

  /* --- Environmental mechanics list ----------------------------------- */

  .env-mechanics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .env-mechanics li {
    font-family: var(--font-serif);
    color: var(--color-text);
    font-size: var(--text-base);
    line-height: var(--line-snug);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border-strong);
    margin: 0;
  }

  /* --- Key NPCs ------------------------------------------------------- */

  .key-npcs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
