---
// =============================================================================
// BADGE
// =============================================================================
// A small pill used everywhere: discipline tags, rank labels, severity
// markers, weapon qualities, faction types, etc. Variant-driven coloring;
// add a new variant by adding a CSS rule below.
//
// USAGE
//   <Badge label="Psy-Slinger" variant="discipline" />
//   <Badge label="Severe" variant="severity-severe" />
//   <Badge label="Bleed" variant="quality" href="/weapon-qualities/bleed/" />
//
// PROPS
//   label:   the text shown
//   variant: one of: default | discipline | rank | severity-{minor|moderate|severe|critical}
//            | category | type | quality | region | calling | danger | highlight | muted
//   size:    'sm' | 'md' (default 'md')
//   href:    optional — renders as <a> instead of <span>, linkable
//   title:   optional tooltip (especially useful when label is truncated)
// =============================================================================

interface Props {
  label: string;
  variant?: string;
  size?: 'sm' | 'md';
  href?: string;
  title?: string;
}

const { label, variant = 'default', size = 'md', href, title } = Astro.props;

const classes = ['badge', `badge--${variant}`, `badge--${size}`];
const Tag = href ? 'a' : 'span';
---

<Tag class:list={classes} href={href} title={title}>{label}</Tag>

<style>
  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.15em 0.55em;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1.4;
    text-decoration: none;
    vertical-align: middle;
  }

  a.badge:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .badge--sm {
    font-size: calc(var(--text-xs) * 0.9);
    padding: 0.1em 0.45em;
  }

  /* --- Semantic variants ---------------------------------------------------
     Each variant tints both border and text. Background stays transparent
     so badges sit well on any panel color.
     ----------------------------------------------------------------------- */

  .badge--default {
    /* uses base colors */
  }

  .badge--muted {
    color: var(--color-text-faint);
    border-color: var(--color-border);
  }

  .badge--discipline {
    color: var(--color-highlight);
    border-color: var(--color-highlight);
  }

  .badge--rank {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .badge--type {
    color: var(--color-memory);
    border-color: var(--color-memory);
  }

  .badge--category {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .badge--calling {
    color: var(--color-erosion);
    border-color: var(--color-erosion);
  }

  .badge--region {
    color: var(--color-strain);
    border-color: var(--color-strain);
  }

  .badge--quality {
    color: var(--color-text-muted);
    border-color: var(--color-border-strong);
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xs);
  }

  .badge--severity-minor {
    color: var(--color-text-muted);
    border-color: var(--color-text-faint);
  }

  .badge--severity-moderate {
    color: var(--color-highlight);
    border-color: var(--color-highlight);
  }

  .badge--severity-severe {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .badge--severity-critical {
    color: var(--color-danger);
    border-color: var(--color-danger);
  }

  .badge--highlight {
    color: var(--color-highlight);
    border-color: var(--color-highlight);
  }

  .badge--danger {
    color: var(--color-danger);
    border-color: var(--color-danger);
  }
</style>
